# Variables leidas por docker-compose.yml (este archivo, no api/.env.example,
# es el que docker compose busca automaticamente junto al compose.yml).
# Copiar a ".env" en esta misma carpeta si necesitas cambiar los defaults.

# URL de la API que se hornea en el build del frontend.
VITE_API_URL=http://localhost:8000

# DB de la API dentro del contenedor (default: SQLite en el volumen api_data).
# DATABASE_URL=sqlite:////data/trading_system.db

# Solo si usas `docker compose --profile postgres up -d`:
# POSTGRES_USER=user_admin
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=stocks_db
