# Database Configuration
# SQLite for local development (default, no setup needed): sqlite:///./trading_system.db
# PostgreSQL for production (ver docker-compose.yml): postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./trading_system.db

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-this-in-production

# API Configuration
# Solo para "python main.py" en local. En Docker/Render el bind real de
# gunicorn lo controla $PORT (ver Dockerfile) — Render lo inyecta solo.
API_HOST=0.0.0.0
API_PORT=8000

# Modelo ML (opcional)
# Ruta al .pkl del modelo. Si se omite, usa api/ml/artifacts/lr_elasticnet_global_expB.pkl
# (Regresion Logistica elasticnet, global, Exp B - ver RESULTADOS_OPTIMIZADOS/docs/GUIA_PROGRESO.md)
# MODEL_PATH=

# Refresco automatico (opcional)
# Hora (24h, America/New_York) a la que corre el refresco diario de datos+senales.
# Por defecto 16:30 hora de Nueva York (30 min despues del cierre de NYSE).
# REFRESH_HOUR=16
# REFRESH_MINUTE=30

# Solo para docker-compose.yml (Postgres opcional, no usado por defecto)
# POSTGRES_USER=user_admin
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=stocks_db
